# Copy this file to .env and add your Groq API key.
# Never commit real credentials or put them in source code.
QWEN_API_KEY=replace-with-your-groq-key
QWEN_BASE_URL=https://api.groq.com/openai/v1
QWEN_MODEL=qwen/qwen3.8-27b

# Supabase credentials belong only in local .env or the deployment secret manager.
DATA_BACKEND=postgresql
DATABASE_URL=postgresql://postgres:<YOUR-PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
DATABASE_SSLMODE=require

# Generate a different random value for each environment (at least 32 characters).
SECRET_KEY=replace-with-your-own-random-secret-key

