# Copia el archivo a .env y completa los valores en el servidor.
SECRET_KEY=
FLASK_DEBUG=0
# En producción con HTTPS usa 1.
SESSION_COOKIE_SECURE=0

# Único almacenamiento operativo
DATA_BACKEND=postgresql
DATABASE_URL=
DATABASE_SSLMODE=require

# Texto y documentos. También se admite GROQ_API_KEY.
QWEN_API_KEY=
QWEN_BASE_URL=https://api.groq.com/openai/v1
QWEN_MODEL=qwen/qwen3-32b
QWEN_TIMEOUT=45
# Si se omite, el copiloto administrativo hereda QWEN_MODEL.
ADMIN_QWEN_MODEL=
ADMIN_AI_TIMEOUT=12

# Visión
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Mercado Pago Checkout Pro. Configura solo para negocios habilitados.
MARKET_PUBLIC_URL=
MP_WEBHOOK_SECRET=
# Ejemplo de nombre para el negocio 42: MP_ACCESS_TOKEN_42
