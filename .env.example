# Variables de entorno; completa los valores secretos fuera del repositorio.
SECRET_KEY=
FLASK_DEBUG=0
FLASK_TESTING=0
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=3600
WTF_CSRF_TIME_LIMIT=3600
MAX_CONTENT_LENGTH=2097152
LOG_LEVEL=INFO

# PostgreSQL
DATA_BACKEND=postgresql
DATABASE_URL=
DATABASE_SSLMODE=require

# Proveedores de IA
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_VISION_MODEL=openai/gpt-4o-mini
AI_TIMEOUT=45
ADMIN_AI_BASE_URL=https://openrouter.ai/api/v1
ADMIN_AI_API_KEY=
ADMIN_AI_MODEL=openai/gpt-4o-mini
ADMIN_AI_TIMEOUT=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
QWEN_API_KEY=
GROQ_API_KEY=

# Servicios y comunicaciones
SECURITY_EMAIL_PROVIDER=
SECURITY_FROM_EMAIL=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# Pagos (el token puede estar separado por restaurante)
MARKET_PUBLIC_URL=
MP_WEBHOOK_SECRET=
# Configura MP_ACCESS_TOKEN_<ID_DE_RESTAURANTE> para cada negocio que cobre.

# Anclaje de reseñas en Polygon Amoy
ANCHOR_STORE=postgres
ANCHOR_MODE=dry_run
ANCHOR_PSEUDONYM_SECRET=
CHAIN_RPC_URL=
CHAIN_ID=80002
ANCHOR_CONTRACT=
ANCHOR_PRIVATE_KEY=
ANCHOR_CONTRACT_METHOD=anchor
ANCHOR_GAS_LIMIT=150000
ANCHOR_RPC_TIMEOUT=30
ANCHOR_RECEIPT_TIMEOUT=120
ANCHOR_RECEIPT_POLL_SECONDS=20
ANCHOR_MAX_ATTEMPTS=5
ANCHOR_RETRY_BASE_SECONDS=30
ANCHOR_RETRY_MAX_SECONDS=1800
ANCHOR_WORKER_LEASE_SECONDS=180
ANCHOR_WORKER_INTERVAL_SECONDS=60

# Clave independiente para firmas HMAC-SHA256 de raíces de auditoría (mínimo 32 bytes).
AUDIT_SIGNING_KEY=f0593ba47ff6a8df31be5672df9b4006795d55bbc704cd15a579cfed0b81d3e3
# Firma/verificación periódica opcional; desactivada durante pytest y modo testing.
INTEGRITY_AUTO_ENABLED=false
INTEGRITY_INTERVAL_SECONDS=300
INTEGRITY_BATCH_SIZE=500
