# Configuración general de Flask
SECRET_KEY=
FLASK_DEBUG=0
# En producción con HTTPS usa 1.
SESSION_COOKIE_SECURE=0

# Base de datos (Supabase)
DATA_BACKEND=postgresql
DATABASE_URL=
DATABASE_SSLMODE=require
# Por proceso: 4 conexiones como máximo. No cambia host/puerto ni modalidad.
DATABASE_POOL_MAX=4
DATABASE_POOL_TIMEOUT=5
DATABASE_CONNECT_TIMEOUT=5
# Límites locales de cada transacción de documentos (milisegundos).
DATABASE_STATEMENT_TIMEOUT_MS=8000
DATABASE_LOCK_TIMEOUT_MS=2000

# Configuración única de IA (OpenRouter)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
OPENROUTER_API_KEY=

# Modelos activos (texto y visión)
AI_MODEL=openai/gpt-4o-mini
AI_VISION_MODEL=openai/gpt-4o-mini
AI_TIMEOUT=45

# Configuración de IA para el panel de administrador (usa los mismos datos)
ADMIN_AI_BASE_URL=https://openrouter.ai/api/v1
ADMIN_AI_MODEL=openai/gpt-4o-mini
ADMIN_AI_TIMEOUT=30

# Generación editorial offline; usa la misma clave de OpenRouter.
AI_IMAGE_MODEL=google/gemini-2.5-flash-image

# Códigos de seguridad transaccionales (credenciales solo en .env del servidor)
SECURITY_EMAIL_PROVIDER=resend
SECURITY_FROM_EMAIL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
